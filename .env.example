# ==============================================================================
# EduMentor AI Backend — Environment Configuration
# Copy this file to .env and provide your actual credentials
# ==============================================================================

# AI Provider Configuration (Default: Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Alternative AI Provider (Optional: OpenAI, Groq, DeepSeek, etc.)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# PostgreSQL / Supabase Database Connection
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres

# JWT Security
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
